#!/usr/bin/env python3
"""Two real review rounds on a seeded change, to watch the reviewer work without a full loop.

Round 1 reviews change/avg.js: a wrong divisor and a strategy class hierarchy nobody needs.
Round 2 resumes the same Codex thread with fix/avg.js, which fixes the divisor but counts
zeros, and with the hierarchy finding marked as rejected by the human.

Needs the Codex CLI. Takes a minute or two. Routes are the ones the starting profile gives.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

DEMO = Path(__file__).resolve().parent
SKILL = DEMO.parent


def git(repo, *args):
    identity = ["-c", "user.name=demo", "-c", "user.email=demo@example.com"]
    return subprocess.run(["git", *identity, *args], cwd=repo, check=True, text=True, capture_output=True).stdout


def snapshot(repo, run, k):
    tree = subprocess.run([SKILL / "bin/snapshot"], cwd=repo, check=True, text=True, capture_output=True).stdout
    (run / f"T{k}").write_text(tree)


def reviewer_prompt(k, applied="", rejected=""):
    if k == 1:
        prompt = (SKILL / "prompts/reviewer.md").read_text()
        return (
            prompt.replace("{{BRIEF}}", (DEMO / "brief.md").read_text())
            .replace("{{DO_NOT_FLAG}}", "- (none)")
            .replace("{{LOOK_FOR}}", "- (none)")
        )

    prompt = (SKILL / "prompts/reviewer-next.md").read_text()
    return prompt.replace("{{ROUND}}", str(k)).replace("{{APPLIED}}", applied).replace("{{REJECTED}}", rejected)


def forget_threads(run):
    threads = run / "threads"
    if not threads.exists():
        return

    sessions = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "sessions"
    for thread in threads.read_text().split():
        for session in sessions.rglob(f"*{thread}.jsonl"):
            session.unlink()


def route(f):
    if f["touches"]:
        return "you decide: the fix touches " + ", ".join(f["touches"])
    if f["changes_behavior"]:
        return "you decide: the fix changes behaviour"

    large = f["files_touched"] > 1 or f["adds_lines"] + f["removes_lines"] > 30
    if large:
        return "you decide: the fix is large"
    if f["confidence"] != "high":
        return "you decide: the reviewer is not sure"

    return "runs without you"


def paragraph(text, label=""):
    return textwrap.fill(" ".join(text.split()), 92, initial_indent="      " + label, subsequent_indent="      ")


def show(run, k):
    review = json.loads((run / f"review-{k}.json").read_text())
    count = len(review["findings"])
    print(f"\nRound {k}: verdict {review['verdict']}, {count} finding{'' if count == 1 else 's'}")

    if review["simplest_alternative"]:
        print(paragraph(review["simplest_alternative"], "Simpler shape: "))

    for f in review["findings"]:
        meta = [f"{f['category']}, {f['severity']}", f"{f['file']}:{f['line']}", route(f)]
        if f["prior_id"]:
            meta.insert(2, f"{f['origin'].replace('_', ' ')} of {f['prior_id']}")

        print(f"\n{f['id']:5} {f['title']}")
        print("      " + " · ".join(meta))
        print(paragraph(f["failure_scenario"]))
        print(paragraph(f["impact"], "If skipped: "))
        print(paragraph(f["fix"], "Fix: "))
        if f["fix_sketch"]:
            print(textwrap.indent(f["fix_sketch"].rstrip(), "        "))

    return review


def review_round(repo, run, k, **context):
    snapshot(repo, run, k)
    (run / f"review-{k}.md").write_text(reviewer_prompt(k, **context))
    print()
    subprocess.run([SKILL / "bin/review", run, str(k)], cwd=repo, check=True)
    return show(run, k)


def main():
    sys.stdout.reconfigure(line_buffering=True)
    work = Path(tempfile.mkdtemp(prefix="dev-loop-demo-"))
    try:
        demo(work)
    finally:
        forget_threads(work / "run")
        shutil.rmtree(work)


def demo(work):
    repo, run = work / "repo", work / "run"
    repo.mkdir()
    run.mkdir()
    shutil.copy(SKILL / "settings.json", run / "settings.json")

    shutil.copy(DEMO / "base/sum.js", repo / "sum.js")
    git(repo, "init", "-q", "-b", "main")
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", "base")
    snapshot(repo, run, 0)

    shutil.copy(DEMO / "change/avg.js", repo / "avg.js")
    first = review_round(repo, run, 1)

    bug = next((f for f in first["findings"] if f["category"] == "bug"), None)
    if bug is None:
        print("\nThe reviewer reported no bug this time, so the demo stops after round 1.")
        return

    rejected = [f for f in first["findings"] if f is not bug]
    print(f"\nThe human accepts {bug['id']} and rejects the rest as `later`. The writer applies a fix.")

    shutil.copy(DEMO / "fix/avg.js", repo / "avg.js")
    review_round(
        repo,
        run,
        2,
        applied=f"- {bug['id']} {bug['file']}:{bug['line']}: {bug['fix']}",
        rejected="\n".join(f"- {f['id']} {f['file']}:{f['line']}: {f['title']}. Rejected: later." for f in rejected) or "- (none)",
    )


if __name__ == "__main__":
    main()
