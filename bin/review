#!/usr/bin/env bash
# Usage: review <run-dir> <round>
# One review round in a fresh Codex thread. Reads <run>/settings.json, <run>/review-<k>.md
# and the T* snapshots; writes <run>/review-<k>.json. Prints a live feed of what the reviewer
# says and runs; the raw events go to <run>/review-<k>.jsonl and Codex's stderr to
# <run>/review-<k>.log.
set -euo pipefail

run=$1
k=$2
skill=$(cd "$(dirname "$0")/.." && pwd)

read -r model effort < <(python3 -c '
import json, sys
reviewer = json.load(open(sys.argv[1]))["reviewer"]
print(reviewer["model"], reviewer["effort"])
' "$run/settings.json")

base=$(cat "$run/T0")
now=$(cat "$run/T$k")

{
  cat "$run/review-$k.md"
  printf '\n<full_diff>\n'
  git diff "$base" "$now"
  printf '</full_diff>\n'

  if [ "$k" -gt 1 ]; then
    prev=$(cat "$run/T$((k - 1))")
    printf '\n<delta_diff>\n'
    git diff "$prev" "$now"
    printf '</delta_diff>\n'
  fi
} > "$run/review-$k.prompt"

echo "round $k: $model/$effort reads the change"

codex exec \
  --json \
  -m "$model" \
  -c "model_reasoning_effort=$effort" \
  -c model_reasoning_summary=concise \
  -s read-only \
  -C "$(git rev-parse --show-toplevel)" \
  --output-schema "$skill/review.schema.json" \
  -o "$run/review-$k.json" \
  - < "$run/review-$k.prompt" 2> "$run/review-$k.log" \
  | tee "$run/review-$k.jsonl" \
  | "$skill/bin/feed"
